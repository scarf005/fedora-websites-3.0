#: title
msgid "IOT Community"
msgstr ""

#~ msgid "IoT Community Part 2"
#~ msgstr "IoT Közösség 2. rész"

#~ msgid "Join a community of users and contributors focused on Fedora IoT.\n"
#~ msgstr ""
#~ "Csatlakozzon a Fedora IoT részére koncentráló közreműködők és felhasználók "
#~ "közösségéhez\n"

#~ msgid "Community"
#~ msgstr "Közösség"

#~ msgid "Join a community of users and contributors focused on Fedora IoT."
#~ msgstr ""
#~ "Csatlakozzon a Fedora IoT részére koncentráló közreműködők és felhasználók "
#~ "közösségéhez."

#~ msgid ""
#~ "Fedora IoT is created by a team in the Fedora Project community called the "
#~ "IoT Working Group. It is comprised of official members who have decision-"
#~ "making powers, as well as other contributors. Learn more about this group "
#~ "and how you can get involved on [the IoT Working Group website](https://docs."
#~ "fedoraproject.org/en/IoTWG)."
#~ msgstr ""
#~ "A Fedora IoT-t a Fedora Project közösség IoT Working Group nevű csapata "
#~ "hozza létre. A szervezet döntési jogkörrel rendelkező hivatalos tagokból, "
#~ "valamint egyéb közreműködőkből áll. Tudjon meg többet erről a csoportról és "
#~ "a részvétel módjáról [the IoT Working Group website] (https://docs."
#~ "fedoraproject.org/en/IoTWG)."

#~ msgid "Communication channels"
#~ msgstr "Kommunikációs csatornák"

#~ msgid "Forum"
#~ msgstr "Fórum"

#~ msgid ""
#~ "The Fedora IoT tag on Fedora's Discourse-based discussion forum is a great "
#~ "place to connect with other Fedora Workstation users and contributors."
#~ msgstr ""
#~ "A Fedora IoT címkével a Fedora Discourse alapú vitafórumán remek hely a "
#~ "Fedora Workstation többi felhasználójával és közreműködőjével való "
#~ "kapcsolattartásra."

#~ msgid "Fedora Discussion logo with chat bubble icons"
#~ msgstr "Fedora Discussion logó chat buborék ikonokkal"

#~ msgid "Visit Now"
#~ msgstr "Látogassa meg most"

#~ msgid "Chat"
#~ msgstr "Csevegés"

#~ msgid "A picture!"
#~ msgstr "Egy kép!"

#~ msgid ""
#~ "You can chat with the Fedora IoT Working Group via either Matrix or IRC: "
#~ "#iot:fedoraproject.org on Matrix and #fedora-iot on irc.libera.chat."
#~ msgstr ""
#~ "A Fedora IoT Munkacsoporttal a Mátrixon vagy az IRC-n keresztül cseveghet: "
#~ "#iot:fedoraproject.org a Matrixon és #fedora-iot az irc.libera.chaten."

#~ msgid "Chat now or forever hold your peace"
#~ msgstr "Csevegjen most, vagy béke tartsa meg örökre"

#~ msgid "Mailing list"
#~ msgstr "Levelezőlista"

#~ msgid ""
#~ "The Fedora IoT Working Group sends meeting agendas and minutes and has "
#~ "discussions on their mailing list at **[iot@lists.fedoraproject."
#~ "org](https://lists.fedoraproject.org/archives/list/iot@lists.fedoraproject."
#~ "org/)**."
#~ msgstr ""
#~ "A Fedora IoT Munkacsoport elküldi az ülések napirendjét és jegyzőkönyvét, "
#~ "valamint a **[iot@lists.fedoraproject.org](https://lists.fedoraproject.org/"
#~ "archives/list/iot@lists.fedoraproject) címen lévő levelezőlistáján folytatja "
#~ "a megbeszéléseket. org/)**."

#~ msgid "Flock to Fedora IoT or something"
#~ msgstr "Flock a Fedora IoT-hez vagy hasonló"

#~ msgid "Visit now"
#~ msgstr "Látogassa meg most"
